# Copy to .env in this directory, edit, then: docker compose up -d --build

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

JWT_SECRET=change-me-to-a-long-random-string
AGENT_TOKEN=change-me-32-chars-minimum-token-value

# The address your BROWSER will open, and the address it will call the API
# on -- not container-internal names. localhost:* only works when you're on
# the same machine as Docker; for remote access set these to the host's real
# address, e.g. http://192.168.1.50:3000 / http://192.168.1.50:8080.
PUBLIC_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8080
# Passkeys need this to exactly match PUBLIC_URL's hostname (no scheme, no
# port). Leave as localhost unless you changed PUBLIC_URL above.
WEBAUTHN_RPID=localhost

WEB_PORT=3000
BACKEND_PORT=8080

# No analytics entries here on purpose: GA4 and Microsoft Clarity
# credentials are baked into the official images at build time by
# .github/workflows/release.yml, not read from this file. See
# docker/README.md.
