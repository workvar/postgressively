# syntax=docker/dockerfile:1
# Build context: repo root (see docker-compose.yml's `context: ..`)
#
# --platform=$BUILDPLATFORM pins the builder stage to the runner's own
# architecture (amd64 in CI) regardless of which platform this image is
# being built for, so `go build` cross-compiles natively via GOOS/GOARCH
# instead of running under QEMU emulation -- the slow part of a multi-arch
# build. Only the tiny runtime stage below (an `apk add`) needs emulation.
FROM --platform=$BUILDPLATFORM golang:1.23-alpine AS build
WORKDIR /src/backend
COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY backend/ ./
ARG TARGETOS
ARG TARGETARCH
# VERSION, GA_*, and GH_BUG_TOKEN are baked into the binary via ldflags
# below (internal/version.Version, internal/telemetry.*, internal/bugs.Token)
# -- never read from the environment at runtime. Passed as build args from
# .github/workflows/release.yml for the published image; defaults keep
# telemetry and bug reporting inert for a plain `docker compose build`.
ARG VERSION=dev
ARG GA_MEASUREMENT_ID=
ARG GA_API_SECRET=
ARG GH_BUG_TOKEN=
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -ldflags "-X github.com/postggresively/backend/internal/version.Version=${VERSION} \
                        -X github.com/postggresively/backend/internal/telemetry.MeasurementID=${GA_MEASUREMENT_ID} \
                        -X github.com/postggresively/backend/internal/telemetry.APISecret=${GA_API_SECRET} \
                        -X github.com/postggresively/backend/internal/bugs.Token=${GH_BUG_TOKEN}" \
    -o /out/postggresively-backend ./cmd/server

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/postggresively-backend /usr/local/bin/postggresively-backend
ENTRYPOINT ["/usr/local/bin/postggresively-backend"]
