# Build context: repo root (see docker-compose.yml's `context: ..`)
FROM golang:1.23-alpine AS build
WORKDIR /src/agent
COPY agent/go.mod ./
RUN go mod download
COPY agent/ ./
RUN CGO_ENABLED=0 go build -o /out/postggresively-agent ./cmd/agent

FROM alpine:3.20
# pg_dump, used by the agent's backup endpoint. Kept at the same major
# version as the postgres image in docker-compose.yml.
RUN apk add --no-cache ca-certificates postgresql16-client
COPY --from=build /out/postggresively-agent /usr/local/bin/postggresively-agent
ENTRYPOINT ["/usr/local/bin/postggresively-agent"]
