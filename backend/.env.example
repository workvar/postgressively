PG_ADDR=:8080
PG_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# The console's own database: accounts, passkeys, saved queries, audit log.
# Created automatically on first boot if it does not exist.
PG_META_DATABASE=postggresively
PG_JWT_SECRET=change-me-to-a-long-random-string
# Encrypts the connection strings of databases added under Connections.
# Defaults to PG_JWT_SECRET. Changing it makes existing saved connections
# undecryptable, and they have to be added again.
PG_SECRET_KEY=
PG_AGENT_URL=http://127.0.0.1:8081
PG_AGENT_TOKEN=change-me-32-chars-minimum-token-value
PG_CORS_ORIGIN=http://localhost:3000
PG_READ_ONLY=false
PG_MAX_ROWS=500
PG_QUERY_TIMEOUT_SECONDS=30

# Passkeys (WebAuthn). RPID is the registrable domain the UI is served from,
# with no scheme or port. PG_WEBAUTHN_ORIGINS is a comma-separated list of the
# exact origins the browser will send; it defaults to PG_CORS_ORIGIN.
PG_WEBAUTHN_RPID=localhost
PG_WEBAUTHN_NAME=Postggresively
PG_WEBAUTHN_ORIGINS=http://localhost:3000
