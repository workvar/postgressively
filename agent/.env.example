AGENT_ADDR=127.0.0.1:8081
AGENT_TOKEN=change-me-32-chars-minimum-token-value
AGENT_PG_SERVICE=postgresql
# auto | systemd | brew | pgctl. auto probes systemctl, then brew, then pg_ctl.
AGENT_SERVICE_MANAGER=auto
AGENT_BACKUP_DIR=/var/backups/postggresively
# leave empty to resolve Postgres binaries from $PATH
AGENT_PG_BIN_DIR=
# required by the pgctl backend; also used to locate log files
AGENT_PG_DATA_DIR=
AGENT_PG_HOST=127.0.0.1
AGENT_PG_PORT=5432
AGENT_PG_USER=postgres
# leave empty to read logs from journalctl, then conventional log paths
AGENT_PG_LOG_FILE=
AGENT_ALLOW_SERVICE_CONTROL=true
